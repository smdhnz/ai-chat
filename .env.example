# 公開URL。Discord OAuthのRedirect URIはこのURL/api/auth/callback/discordです。
APP_ORIGIN=https://chat.fumiya.dev
PORT=3000
COOKIE_SECURE=1

# Bunサーバーがページ要求を転送するNext.jsサーバー。Dockerでは既定で設定済みです。
# WEB_ORIGIN=http://127.0.0.1:3002

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ログインを許可するDiscordユーザーID。複数はカンマ区切り。
ALLOWED_DISCORD_USER_IDS=

# ChatGPT Plus/ProのCodexサブスクモデル
CODEX_MODEL=gpt-5.6-sol
AI_TIMEOUT_MS=600000

# skills.shからの追加時にGitHub APIのレート上限を緩和する場合のみ設定。
# GITHUB_TOKEN=

# 1リクエスト内のアップロード合計上限
MAX_UPLOAD_BYTES=20971520
DATA_DIR=data

# Codex OAuth認証はユーザー別ではなく、アプリ全体でこの1ファイルを共有します。
# 未設定時は DATA_DIR/auth.json です。
# PI_AUTH_PATH=/app/data/auth.json
