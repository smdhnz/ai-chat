# 公開URL。Discord OAuthのRedirect URIはこのURL/api/auth/callback/discordです。
APP_ORIGIN=https://chat.fumiya.dev
PORT=3000
COOKIE_SECURE=1

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ログインを許可するDiscordユーザーID。複数はカンマ区切り。
ALLOWED_DISCORD_USER_IDS=

# ChatGPT Plus/ProのCodexサブスクモデル
AI_TIMEOUT_MS=600000

# 1リクエスト内のアップロード合計上限
MAX_UPLOAD_BYTES=20971520
DATA_DIR=data

# 未設定時はホスト側の ~/.pi/agent/auth.json を使うため、ローカルでは既存のpi認証が共有されます。
# 本番（Docker）ではホスト認証と分離し、永続ボリューム内の専用ファイルを指定してください。
# PI_AUTH_PATH=/app/data/auth.json
